# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Runtime data (not source)
/data/
/config/config.json
/config/*.local.json
*.bsp
.env

# Credentials — the account store and the first-run bootstrap password.
# These are generated per install and must never reach a repository.
/config/auth.json
/config/auth.json.tmp
/config/initial-admin-password.txt

# Test artifacts
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Local Claude Code session state
.claude/

# In-progress atomic config writes
/config/.config-*.json.tmp

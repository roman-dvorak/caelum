# Bootstrap-only settings (see src/caelum/settings.py). Runtime AppConfig
# (camera, exposure policy, retention, upload, plugins, ...) lives in
# config/config.json + Redis instead, managed via the API/config manager.

CAELUM_CONFIG_DIR=./config
CAELUM_DATA_DIR=./data

CAELUM_HTTP_HOST=0.0.0.0
CAELUM_HTTP_PORT=8000

CAELUM_REDIS_URL=redis://127.0.0.1:6379/0

# config.json's camera.backend is authoritative. Set this ("mock" |
# "picamera2") only to explicitly override it for local dev/CI — leave unset
# otherwise; there is no silent auto-detection on real hardware.
# CAELUM_CAMERA_BACKEND=mock

CAELUM_LOG_LEVEL=INFO
